DJANGO_SECRET_KEY=replace-with-a-random-secret-at-least-50-characters-long
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=true
# Set to true only when a trusted reverse proxy strips/sets X-Forwarded-Proto.
DJANGO_TRUST_PROXY=false

# Frontend origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# API keys for training endpoints (comma-separated). Staff users can also train.
TRAINING_API_KEYS=replace-with-a-long-random-key
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Optional market-data provider key.
ALPHAVANTAGE_API_KEY=

# PostgreSQL (optional; SQLite is the development default).
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=quantatlas
# DB_USER=quantatlas
# DB_PASSWORD=replace-me
# DB_HOST=localhost
# DB_PORT=5432
